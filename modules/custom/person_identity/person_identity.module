<?php

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Entity\Element\EntityAutocomplete;
use Drupal\Core\Entity\EntityReferenceSelection\SelectionWithAutocreateInterface;
use Drupal\node\NodeInterface;
use Drupal\person_identity\Identity;

/** Implements hook_node_presave(). */
function person_identity_node_presave(NodeInterface $node): void {
  Identity::normalize($node);
}

/** Implements hook_form_BASE_FORM_ID_alter(). */
function person_identity_form_node_form_alter(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  if ($node->bundle() !== 'person' || !$node->hasField('field_person_name')) {
    return;
  }
  $form['title']['#access'] = FALSE;
  $form['field_person_name']['widget'][0]['value']['#required'] = TRUE;
  $form['#entity_builders'][] = 'person_identity_build_entity';
}

/** Implements hook_field_widget_single_element_form_alter(). */
function person_identity_field_widget_single_element_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  $items = $context['items'];
  if ($items->getEntity()->getEntityTypeId() === 'node' && $items->getEntity()->bundle() === 'person'
    && in_array($items->getName(), ['field_mother', 'field_father', 'field_person_siblings', 'field_motherof'], TRUE)
    && ($element['target_id']['#type'] ?? '') === 'entity_autocomplete') {
    $element['target_id']['#element_validate'] = ['person_identity_validate_relative_autocomplete'];
  }
}

/** Distinguish lifespan suffixes from the entity IDs in autocomplete results. */
function person_identity_validate_relative_autocomplete(array &$element, FormStateInterface $form_state, array &$complete_form): void {
  $input = $element['#value'] ?? NULL;
  if (is_string($input) && !empty($element['#autocreate'])
    && preg_match('/^.+?\s*\((?:c\.?\s*)?\d{4}\s*[-–]\s*(?:(?:c\.?\s*)?\d{4}|\?*)\)$/u', trim($input))) {
    $input = trim($input);
    $options = $element['#selection_settings'] + ['target_type' => $element['#target_type'], 'handler' => $element['#selection_handler']];
    $handler = \Drupal::service('plugin.manager.entity_reference_selection')->getInstance($options);
    $matches = [];
    foreach ($handler->getReferenceableEntities($input, '=', 6) as $entities) {
      $matches += $entities;
    }
    if (count($matches) > 1) {
      $form_state->setError($element, t('Multiple people match %name. Select the correct person from the suggestions.', ['%name' => $input]));
      return;
    }
    if ($matches) {
      $element['#value'] = [['target_id' => key($matches)]];
    }
    elseif ($handler instanceof SelectionWithAutocreateInterface) {
      $element['#value'] = [['entity' => $handler->createNewEntity($element['#target_type'], $element['#autocreate']['bundle'], $input, $element['#autocreate']['uid'])]];
    }
  }
  EntityAutocomplete::validateEntityAutocomplete($element, $form_state, $complete_form);
}

/** Build the generated title before entity validation runs. */
function person_identity_build_entity($entity_type, NodeInterface $entity, array &$form, FormStateInterface $form_state): void {
  Identity::normalize($entity);
}

/** Format complete Person dates in field displays without inventing precision. */
function person_identity_preprocess_field(array &$variables): void {
  $element = $variables['element'];
  if (($element['#entity_type'] ?? '') !== 'node' || ($element['#bundle'] ?? '') !== 'person'
    || !in_array($element['#field_name'] ?? '', ['field_person_birth', 'field_person_death'], TRUE)) {
    return;
  }
  foreach ($variables['items'] as $delta => &$item) {
    $value = (string) ($element['#items'][$delta]->value ?? '');
    if (preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $value, $parts)
      && checkdate((int) $parts[2], (int) $parts[3], (int) $parts[1])) {
      $item['content'] = ['#plain_text' => \Drupal::service('date.formatter')->format(gmmktime(12, 0, 0, (int) $parts[2], (int) $parts[3], (int) $parts[1]), 'custom', 'F j, Y', 'UTC')];
    }
  }
}

/** Implements hook_pathauto_alias_alter(). */
function person_identity_pathauto_alias_alter(&$alias, array &$context): void {
  $node = $context['data']['node'] ?? NULL;
  if ($node instanceof NodeInterface && $node->bundle() === 'person' && $node->hasField('field_person_name')) {
    $alias = Identity::alias(
      (string) $node->get('field_person_name')->value,
      (string) $node->get('field_person_birth')->value,
      (string) $node->get('field_person_death')->value,
    );
  }
}

/** Implements hook_metatags_alter(). */
function person_identity_metatags_alter(array &$metatags, array &$context): void {
  $node = $context['entity'] ?? NULL;
  if (!$node instanceof NodeInterface) {
    return;
  }
  if ($node->bundle() === 'person') {
    // This module supplies one complete Person object, including family links.
    foreach (array_keys($metatags) as $key) {
      if (str_starts_with($key, 'schema_person_')) {
        unset($metatags[$key]);
      }
    }
    $metatags['og_type'] = 'profile';
  }
  if (in_array($node->bundle(), ['book_cover_and_description', 'external_published_books'], TRUE) && $node->hasField('field_book_authors') && !$node->get('field_book_authors')->isEmpty()) {
    foreach (array_keys($metatags) as $key) {
      if (str_starts_with($key, 'schema_book_')) {
        unset($metatags[$key]);
      }
    }
    $metatags['og_type'] = 'book';
  }
  if (in_array($node->bundle(), ['article', 'psychology_and_self_help_article', 'book_part', 'book'], TRUE)) {
    foreach (array_keys($metatags) as $key) {
      if (str_starts_with($key, 'schema_article_') || str_starts_with($key, 'schema_book_')) {
        unset($metatags[$key]);
      }
    }
  }
  if (empty($metatags['og_image'])) {
    $image_url = person_identity_node_image_url($node);
    if ($image_url !== '') {
      $metatags['og_image'] = $image_url;
      if (empty($metatags['twitter_cards_image'])) {
        $metatags['twitter_cards_image'] = $image_url;
      }
    }
  }
}

/** Extract a clean plain-text summary or excerpt from a node body. */
function person_identity_node_summary(NodeInterface $node, int $max_length = 240): string {
  if (!$node->hasField('body') || $node->get('body')->isEmpty()) {
    return '';
  }
  $summary = trim(strip_tags((string) $node->get('body')->summary));
  if ($summary !== '') {
    return preg_replace('/\s+/u', ' ', $summary);
  }
  $raw = (string) $node->get('body')->value;
  $raw = preg_replace('/<!--.*?-->/s', ' ', $raw);
  $text = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags($raw), ENT_QUOTES | ENT_HTML5, 'UTF-8')));
  if ($text === '' || mb_strlen($text) <= $max_length) {
    return $text;
  }
  $cut = mb_substr($text, 0, $max_length);
  $space = mb_strrpos($cut, ' ');
  return ($space !== FALSE && $space > (int) ($max_length * 0.6) ? mb_substr($cut, 0, $space) : $cut) . '…';
}

/** Resolve an absolute image URL for a node (with parent book or author fallback). */
function person_identity_node_image_url(NodeInterface $node, ?CacheableMetadata $cache = NULL): string {
  $generator = \Drupal::service('file_url_generator');
  foreach (['field_person_featured_image', 'field_book_cover_page', 'field_featured_image', 'field_image'] as $field) {
    if ($node->hasField($field) && !$node->get($field)->isEmpty() && ($file = $node->get($field)->entity)) {
      if ($cache) {
        $cache->addCacheableDependency($file);
      }
      return $generator->generateAbsoluteString($file->getFileUri());
    }
  }
  if (in_array($node->bundle(), ['book_part', 'book'], TRUE) && ($book = person_identity_parent_book($node, $cache))) {
    if ($book->hasField('field_book_cover_page') && !$book->get('field_book_cover_page')->isEmpty() && ($cover = $book->get('field_book_cover_page')->entity)) {
      if ($cache) {
        $cache->addCacheableDependency($cover);
      }
      return $generator->generateAbsoluteString($cover->getFileUri());
    }
  }
  if (in_array($node->bundle(), ['article', 'psychology_and_self_help_article'], TRUE) && ($author = \Drupal\node\Entity\Node::load(558))) {
    if ($cache) {
      $cache->addCacheableDependency($author);
    }
    if ($author->hasField('field_person_featured_image') && !$author->get('field_person_featured_image')->isEmpty() && ($portrait = $author->get('field_person_featured_image')->entity)) {
      if ($cache) {
        $cache->addCacheableDependency($portrait);
      }
      return $generator->generateAbsoluteString($portrait->getFileUri());
    }
  }
  return '';
}

/** Load the root Book node for a Book Part or Book page when accessible. */
function person_identity_parent_book(NodeInterface $node, ?CacheableMetadata $cache = NULL): ?NodeInterface {
  if ($node->isNew()) {
    return NULL;
  }
  $bid = (int) (\Drupal::database()->select('book', 'b')->fields('b', ['bid'])->condition('nid', (int) $node->id())->execute()->fetchField() ?: 0);
  if ($bid <= 0 || $bid === (int) $node->id()) {
    return NULL;
  }
  $book = \Drupal\node\Entity\Node::load($bid);
  if (!$book instanceof NodeInterface) {
    return NULL;
  }
  $access = $book->access('view', NULL, TRUE);
  if ($cache) {
    $cache->addCacheableDependency($book)->addCacheableDependency($access);
  }
  return $access->isAllowed() ? $book : NULL;
}

/** Implements hook_node_view(). */
function person_identity_node_view(array &$build, NodeInterface $node, EntityViewDisplayInterface $display, $view_mode): void {
  // Layout Builder previews can render unsaved placeholder nodes, which have
  // no canonical URL or persistent identity for the structured data below.
  if ($node->isNew()) {
    return;
  }
  if (in_array($view_mode, ['full', 'default'], TRUE)) {
    if ((int) $node->id() === 440 || \Drupal::service('path.matcher')->isFrontPage()) {
      person_identity_front_view($build, $node);
      return;
    }
    if (in_array($node->bundle(), ['book_cover_and_description', 'external_published_books'], TRUE)) {
      person_identity_book_view($build, $node);
      return;
    }
    if (in_array($node->bundle(), ['book_part', 'book'], TRUE)) {
      person_identity_book_part_view($build, $node);
      return;
    }
    if (in_array($node->bundle(), ['article', 'psychology_and_self_help_article'], TRUE)) {
      person_identity_article_view($build, $node);
      return;
    }
  }
  if ($node->bundle() !== 'person' || !in_array($view_mode, ['full', 'default']) || !$node->hasField('field_person_name')) {
    return;
  }
  // The legacy summary is only used when Layout Builder is not in control.
  if (!$display->getThirdPartySetting('layout_builder', 'enabled', FALSE)) {
    // Keep portrait and life facts together, ahead of the biography.
    $header = ['#type' => 'container', '#attributes' => ['class' => ['person-identity-summary']], '#weight' => -100];
    if (!empty($build['field_person_featured_image']) && !$node->get('field_person_featured_image')->isEmpty()) {
      $header['portrait'] = ['#type' => 'container', '#attributes' => ['class' => ['person-identity-summary__portrait']], 'image' => $build['field_person_featured_image']];
    }
    else {
      $header['#attributes']['class'][] = 'person-identity-summary--no-portrait';
    }
    $header['facts'] = ['#type' => 'container', '#attributes' => ['class' => ['person-identity-summary__facts']]];
    foreach (['birth' => t('Born'), 'death' => t('Died')] as $field => $label) {
      $date = trim((string) $node->get('field_person_' . $field)->value);
      if ($date !== '') {
        if (preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $date, $parts) && checkdate((int) $parts[2], (int) $parts[3], (int) $parts[1])) {
          $date = \Drupal::service('date.formatter')->format(gmmktime(12, 0, 0, (int) $parts[2], (int) $parts[3], (int) $parts[1]), 'custom', 'F j, Y', 'UTC');
        }
        $header['facts'][$field] = ['#type' => 'container', '#attributes' => ['class' => ['person-identity-summary__fact']],
          'label' => ['#type' => 'html_tag', '#tag' => 'strong', '#value' => $label . ': '],
          'date' => ['#plain_text' => $date],
        ];
      }
    }
    if ($node->get('field_person_life_status')->value === 'living' && $node->get('field_person_death')->isEmpty()) {
      $header['facts']['living'] = ['#type' => 'html_tag', '#tag' => 'p', '#value' => t('Living'), '#attributes' => ['class' => ['person-identity-summary__living']]];
    }
    foreach (['field_person_birth_name' => t('Birth name'), 'field_person_other_names' => t('Also known as')] as $field => $label) {
      if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
        $header['facts'][$field] = ['#type' => 'container', '#attributes' => ['class' => ['person-identity-summary__fact']],
          'label' => ['#type' => 'html_tag', '#tag' => 'strong', '#value' => $label . ': '],
          'names' => ['#plain_text' => implode(', ', array_column($node->get($field)->getValue(), 'value'))],
        ];
      }
    }
    foreach (['field_person_name', 'field_person_birth', 'field_person_death', 'field_person_life_status', 'field_person_featured_image', 'field_person_birth_name', 'field_person_other_names'] as $field) {
      unset($build[$field]);
    }
    $build['person_identity_header'] = $header;
    $build['#attached']['library'][] = 'person_identity/profile';
  }
  $url = $node->toUrl('canonical', ['absolute' => TRUE])->toString();
  $name = (string) ($node->get('field_person_name')->value ?: $node->label());
  $person = ['@type' => 'Person', '@id' => 'urn:uuid:' . $node->uuid(), 'name' => $name, 'url' => $url, 'mainEntityOfPage' => ['@id' => $url . '#profile']];
  foreach (['field_person_birth_name', 'field_person_other_names'] as $field) {
    if ($node->hasField($field)) {
      foreach ($node->get($field) as $item) {
        if (trim((string) $item->value) !== '' && $item->value !== $name) {
          $person['alternateName'][] = $item->value;
        }
      }
    }
  }
  if (isset($person['alternateName'])) {
    $person['alternateName'] = array_values(array_unique($person['alternateName']));
  }
  foreach (['field_person_given_name' => 'givenName', 'field_person_additional_name' => 'additionalName', 'field_person_family_name' => 'familyName'] as $field => $property) {
    if (!$node->get($field)->isEmpty()) {
      $person[$property] = $node->get($field)->value;
    }
  }
  $summary = $node->get('body')->summary;
  if ($summary) {
    $person['description'] = trim(strip_tags($summary));
  }
  $cache = CacheableMetadata::createFromObject($node);
  if (\Drupal\field\Entity\FieldStorageConfig::loadByName('node', 'field_book_subjects')) {
    $cache->addCacheTags(['node_list:book_cover_and_description', 'node_list:external_published_books']);
    $ids = \Drupal::entityQuery('node')->accessCheck(TRUE)->condition('status', 1)
      ->condition('type', ['book_cover_and_description', 'external_published_books'], 'IN')
      ->condition('field_book_subjects.target_id', $node->id())->execute();
    foreach (\Drupal\node\Entity\Node::loadMultiple($ids) as $work) {
      $access = $work->access('view', NULL, TRUE);
      $cache->addCacheableDependency($work)->addCacheableDependency($access);
      if ($access->isAllowed()) {
        $person['subjectOf'][] = ['@type' => 'Book', '@id' => 'urn:uuid:' . $work->uuid(), 'name' => $work->label(), 'url' => $work->toUrl('canonical', ['absolute' => TRUE])->toString()];
      }
    }
  }
  if ($node->hasField('field_person_featured_image') && !$node->get('field_person_featured_image')->isEmpty()) {
    $image = $node->get('field_person_featured_image')->entity;
    if ($image) {
      $person['image'] = \Drupal::service('file_url_generator')->generateAbsoluteString($image->getFileUri());
      $cache->addCacheableDependency($image);
    }
  }
  if ($node->get('field_person_life_status')->value === 'living') {
    $person['disambiguatingDescription'] = $name . ' is living. ' . ($person['description'] ?? '');
  }
  foreach (['birth' => 'birthDate', 'death' => 'deathDate'] as $field => $property) {
    $date = (string) $node->get('field_person_' . $field)->value;
    // Year-only/approximate dates remain visible without fabricated month/day.
    if (preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $date, $parts) && checkdate((int) $parts[2], (int) $parts[3], (int) $parts[1])) {
      $person[$property] = $date;
    }
  }
  if ($node->hasField('field_identity_profiles')) {
    foreach ($node->get('field_identity_profiles') as $item) {
      if (preg_match('#^https?://#i', $item->uri ?? '')) {
        $person['sameAs'][] = $item->uri;
      }
    }
  }
  foreach (['field_mother' => 'parent', 'field_father' => 'parent', 'field_person_siblings' => 'sibling', 'field_motherof' => 'children'] as $field => $property) {
    if (!$node->hasField($field)) {
      continue;
    }
    foreach ($node->get($field)->referencedEntities() as $relative) {
      $access = $relative->access('view', NULL, TRUE);
      $cache->addCacheableDependency($relative)->addCacheableDependency($access);
      if ($access->isAllowed()) {
        $person[$property][] = ['@type' => 'Person', '@id' => 'urn:uuid:' . $relative->uuid(), 'name' => $relative->get('field_person_name')->value ?: $relative->label(), 'url' => $relative->toUrl('canonical', ['absolute' => TRUE])->toString()];
      }
    }
  }
  $json = ['@context' => 'https://schema.org', '@graph' => [
    ['@type' => 'ProfilePage', '@id' => $url . '#profile', 'url' => $url, 'name' => $node->label(), 'mainEntity' => ['@id' => $person['@id']]],
    $person,
  ]];
  $build['#attached']['html_head'][] = [[
    '#tag' => 'script',
    '#attributes' => ['type' => 'application/ld+json'],
    '#value' => json_encode($json, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT),
  ], 'person_identity_' . $node->id()];
  CacheableMetadata::createFromRenderArray($build)->merge($cache)->applyTo($build);
}

/** Attach Book data with explicit author and subject Person references. */
function person_identity_book_view(array &$build, NodeInterface $node): void {
  if (!$node->hasField('field_book_authors') || $node->get('field_book_authors')->isEmpty()) {
    return;
  }
  $cache = CacheableMetadata::createFromObject($node);
  $book = ['@context' => 'https://schema.org', '@type' => 'Book', '@id' => 'urn:uuid:' . $node->uuid(), 'name' => $node->label(), 'url' => $node->toUrl('canonical', ['absolute' => TRUE])->toString()];
  foreach (['field_book_authors' => 'author', 'field_book_subjects' => 'about'] as $field => $property) {
    if (!$node->hasField($field)) {
      continue;
    }
    foreach ($node->get($field)->referencedEntities() as $person) {
      $access = $person->access('view', NULL, TRUE);
      $cache->addCacheableDependency($person)->addCacheableDependency($access);
      if ($access->isAllowed()) {
        $book[$property][] = ['@type' => 'Person', '@id' => 'urn:uuid:' . $person->uuid(), 'name' => $person->get('field_person_name')->value ?: $person->label(), 'url' => $person->toUrl('canonical', ['absolute' => TRUE])->toString()];
      }
    }
  }
  $summary = person_identity_node_summary($node);
  if ($summary !== '') {
    $book['description'] = $summary;
  }
  if ($node->hasField('field_book_cover_page') && ($cover = $node->get('field_book_cover_page')->entity)) {
    $book['image'] = \Drupal::service('file_url_generator')->generateAbsoluteString($cover->getFileUri());
    $cache->addCacheableDependency($cover);
  }
  if (!empty($book['author'])) {
    $build['#attached']['html_head'][] = [[
      '#tag' => 'script', '#attributes' => ['type' => 'application/ld+json'],
      '#value' => json_encode($book, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT),
    ], 'person_identity_book_' . $node->id()];
  }
  CacheableMetadata::createFromRenderArray($build)->merge($cache)->applyTo($build);
}

/** Attach WebSite structured data on the front page. */
function person_identity_front_view(array &$build, NodeInterface $node): void {
  $cache = CacheableMetadata::createFromObject($node);
  $site_url = \Drupal\Core\Url::fromRoute('<front>', [], ['absolute' => TRUE])->toString();
  $site_name = (string) (\Drupal::config('system.site')->get('name') ?: 'Creative Writing By Bruce Whealton');
  $website = [
    '@context' => 'https://schema.org',
    '@type' => 'WebSite',
    '@id' => rtrim($site_url, '/') . '/#website',
    'name' => $site_name,
    'url' => $site_url,
    'description' => 'Books, memoirs, poetry collections, and psychology articles by Bruce M. Whealton Jr., author and former clinical social worker.',
  ];
  if ($author = \Drupal\node\Entity\Node::load(558)) {
    $access = $author->access('view', NULL, TRUE);
    $cache->addCacheableDependency($author)->addCacheableDependency($access);
    if ($access->isAllowed()) {
      $person_ref = [
        '@type' => 'Person',
        '@id' => 'urn:uuid:' . $author->uuid(),
        'name' => (string) ($author->get('field_person_name')->value ?: $author->label()),
        'url' => $author->toUrl('canonical', ['absolute' => TRUE])->toString(),
      ];
      $website['author'] = $person_ref;
      $website['publisher'] = $person_ref;
    }
  }
  $build['#attached']['html_head'][] = [[
    '#tag' => 'script', '#attributes' => ['type' => 'application/ld+json'],
    '#value' => json_encode($website, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT),
  ], 'person_identity_front'];
  CacheableMetadata::createFromRenderArray($build)->merge($cache)->applyTo($build);
}

/** Attach Chapter structured data on Book Part and Book pages linked to parent Book. */
function person_identity_book_part_view(array &$build, NodeInterface $node): void {
  $cache = CacheableMetadata::createFromObject($node);
  $url = $node->toUrl('canonical', ['absolute' => TRUE])->toString();
  $chapter = [
    '@context' => 'https://schema.org',
    '@type' => 'Chapter',
    '@id' => 'urn:uuid:' . $node->uuid(),
    'name' => $node->label(),
    'headline' => $node->label(),
    'url' => $url,
    'mainEntityOfPage' => ['@type' => 'WebPage', '@id' => $url],
  ];
  $summary = person_identity_node_summary($node);
  if ($summary !== '') {
    $chapter['description'] = $summary;
  }
  $authors = [];
  if ($book = person_identity_parent_book($node, $cache)) {
    $book_ref = [
      '@type' => 'Book',
      '@id' => 'urn:uuid:' . $book->uuid(),
      'name' => $book->label(),
      'url' => $book->toUrl('canonical', ['absolute' => TRUE])->toString(),
    ];
    if ($book->hasField('field_book_authors')) {
      foreach ($book->get('field_book_authors')->referencedEntities() as $person) {
        $access = $person->access('view', NULL, TRUE);
        $cache->addCacheableDependency($person)->addCacheableDependency($access);
        if ($access->isAllowed()) {
          $authors[] = [
            '@type' => 'Person',
            '@id' => 'urn:uuid:' . $person->uuid(),
            'name' => (string) ($person->get('field_person_name')->value ?: $person->label()),
            'url' => $person->toUrl('canonical', ['absolute' => TRUE])->toString(),
          ];
        }
      }
    }
    if ($authors) {
      $book_ref['author'] = $authors;
    }
    $chapter['isPartOf'] = $book_ref;
  }
  if (!$authors && ($author = \Drupal\node\Entity\Node::load(558))) {
    $access = $author->access('view', NULL, TRUE);
    $cache->addCacheableDependency($author)->addCacheableDependency($access);
    if ($access->isAllowed()) {
      $authors[] = [
        '@type' => 'Person',
        '@id' => 'urn:uuid:' . $author->uuid(),
        'name' => (string) ($author->get('field_person_name')->value ?: $author->label()),
        'url' => $author->toUrl('canonical', ['absolute' => TRUE])->toString(),
      ];
    }
  }
  if ($authors) {
    $chapter['author'] = $authors;
  }
  $image_url = person_identity_node_image_url($node, $cache);
  if ($image_url !== '') {
    $chapter['image'] = $image_url;
  }
  $build['#attached']['html_head'][] = [[
    '#tag' => 'script', '#attributes' => ['type' => 'application/ld+json'],
    '#value' => json_encode($chapter, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT),
  ], 'person_identity_book_part_' . $node->id()];
  CacheableMetadata::createFromRenderArray($build)->merge($cache)->applyTo($build);
}

/** Attach Article structured data on Article and Psychology/Self-Help Article nodes. */
function person_identity_article_view(array &$build, NodeInterface $node): void {
  $cache = CacheableMetadata::createFromObject($node);
  $url = $node->toUrl('canonical', ['absolute' => TRUE])->toString();
  $article = [
    '@context' => 'https://schema.org',
    '@type' => 'Article',
    '@id' => 'urn:uuid:' . $node->uuid(),
    'headline' => $node->label(),
    'name' => $node->label(),
    'url' => $url,
    'mainEntityOfPage' => ['@type' => 'WebPage', '@id' => $url],
    'datePublished' => date('c', $node->getCreatedTime()),
    'dateModified' => date('c', $node->getChangedTime()),
  ];
  $summary = person_identity_node_summary($node);
  if ($summary !== '') {
    $article['description'] = $summary;
  }
  if ($author = \Drupal\node\Entity\Node::load(558)) {
    $access = $author->access('view', NULL, TRUE);
    $cache->addCacheableDependency($author)->addCacheableDependency($access);
    if ($access->isAllowed()) {
      $person_ref = [
        '@type' => 'Person',
        '@id' => 'urn:uuid:' . $author->uuid(),
        'name' => (string) ($author->get('field_person_name')->value ?: $author->label()),
        'url' => $author->toUrl('canonical', ['absolute' => TRUE])->toString(),
      ];
      $article['author'] = [$person_ref];
      $article['publisher'] = $person_ref;
    }
  }
  if ($node->hasField('field_related_to_the_book') && !$node->get('field_related_to_the_book')->isEmpty()) {
    foreach ($node->get('field_related_to_the_book')->referencedEntities() as $related) {
      if ($related instanceof NodeInterface) {
        $access = $related->access('view', NULL, TRUE);
        $cache->addCacheableDependency($related)->addCacheableDependency($access);
        if ($access->isAllowed()) {
          $article['about'][] = [
            '@type' => 'Book',
            '@id' => 'urn:uuid:' . $related->uuid(),
            'name' => $related->label(),
            'url' => $related->toUrl('canonical', ['absolute' => TRUE])->toString(),
          ];
        }
      }
    }
  }
  $image_url = person_identity_node_image_url($node, $cache);
  if ($image_url !== '') {
    $article['image'] = $image_url;
  }
  $build['#attached']['html_head'][] = [[
    '#tag' => 'script', '#attributes' => ['type' => 'application/ld+json'],
    '#value' => json_encode($article, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT),
  ], 'person_identity_article_' . $node->id()];
  CacheableMetadata::createFromRenderArray($build)->merge($cache)->applyTo($build);
}
