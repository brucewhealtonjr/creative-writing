{#
/**
 * @file
 * Theme override to display a single page.
 * Hero banner is embedded here so it deploys via git on all environments.
 */
#}
{% set page_attributes = attributes ?: create_attribute() %}
{% set page_classes = ['page']|merge(page_utility_classes ?: []) %}
{% set show_sidebar = page.sidebar_second and not is_front %}
{% set hero_bg = base_path ~ directory ~ '/build/assets/images/dreamlike-sunrise-wisdom.png' %}

<div {{ page_attributes.addClass(page_classes) }}>
  {% block page_navigation %}
    {% include 'radix:page-navigation' %}
  {% endblock %}

  {# ── Hero banner – git-tracked, works on every server ── #}
  <section class="front-hero" aria-labelledby="hero-heading">
    <img class="front-hero__image" src="{{ hero_bg }}" alt="" fetchpriority="high" width="2172" height="724" />
    <div class="front-hero__content">
      <h1 id="hero-heading">Exploring the Depths of the Human Condition</h1>
      <p>through Stories, Essays, and Poetry</p>
      <div class="hero-actions">
        <a href="#books-section" class="btn-hero-primary">Explore My Books</a>
        <a href="#writings-section" class="btn-hero-secondary">Updates &amp; Articles</a>
      </div>
    </div>
  </section>

  <main class="main-content py-5" id="main-content">
    <div class="container">
      <div class="row g-5 justify-content-center">
        <div class="main-content__section {{ show_sidebar ? 'col-lg-8 col-xl-9' : 'col-12' }}">
          {{ page.content }}
        </div>
        {% if show_sidebar %}
          <aside class="main-sidebar col-lg-4 col-xl-3">
            {{ page.sidebar_second }}
          </aside>
        {% endif %}
      </div>
    </div>
  </main>

  {% block page_footer %}
    {% include 'radix:page-footer' %}
  {% endblock %}
</div>
