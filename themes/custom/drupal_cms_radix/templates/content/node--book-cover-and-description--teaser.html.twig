{#
/**
 * @file
 * Theme override for book cover and description teaser nodes.
 * Showcase layout: vertical card for grid display with centered cover image.
 */
#}
{% set node_classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  'node--view-mode-' ~ view_mode|clean_class,
  not node.isPublished() ? 'node--unpublished',
  node.isSticky() ? 'node--sticky',
  'book-showcase-card',
  'h-100'
] %}

<article{{ attributes.addClass(node_classes) }}>
  <a href="{{ url }}" rel="bookmark" class="book-showcase-card__cover-link" aria-label="{{ label }}">
    <div class="book-showcase-card__cover">
      {% if node.isSticky() %}
        <span class="book-showcase-card__featured-badge">★ Featured Work</span>
      {% endif %}
      {% if node.hasField('field_book_cover_page') and not node.get('field_book_cover_page').isEmpty() and node.field_book_cover_page.0.entity is not null %}
        <img src="{{ file_url(node.field_book_cover_page.0.entity.uri.value) }}" alt="{{ node.field_book_cover_page.0.alt ?: label }}" class="book-cover-img" />
      {% else %}
        <div class="book-showcase-card__cover-placeholder">
          <span>{{ label }}</span>
        </div>
      {% endif %}
    </div>
  </a>

  <div class="book-showcase-card__info">
    {{ title_prefix }}
    <h3{{ title_attributes.addClass('book-showcase-card__title') }}>
      <a href="{{ url }}" rel="bookmark" class="book-showcase-card__title-link hover-gold">{{ label }}</a>
    </h3>
    {{ title_suffix }}

    <div class="book-showcase-card__author">
      By <a href="{{ path('entity.node.canonical', {'node': 558}) }}">Bruce Whealton</a>
    </div>

    <div class="book-showcase-card__body">
      {{ content.body }}
    </div>

    <div class="mt-auto pt-2">
      <a href="{{ url }}" class="book-showcase-card__btn">Read Book &amp; Chapters</a>
    </div>
  </div>
</article>
