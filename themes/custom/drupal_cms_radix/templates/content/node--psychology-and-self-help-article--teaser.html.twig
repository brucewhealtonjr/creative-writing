{#
/**
 * @file
 * Theme override for psychology and self help article teaser nodes.
 */
#}
{% set node_classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  'node--view-mode-' ~ view_mode|clean_class,
  not node.isPublished() ? 'node--unpublished',
  'card',
  'h-100',
  'border-0',
  'shadow-sm',
  'bg-white',
  'text-dark',
  'article-teaser-card'
] %}

{% set title_text = label|render|striptags|trim %}
{% set title_lower = title_text|lower %}
{% set owner_name = node.getOwner() ? node.getOwner().getAccountName()|lower : '' %}
{% set has_image = node.hasField('field_image') and not node.get('field_image').isEmpty() and node.field_image.0.entity is not null %}
{% set related_book = (node.hasField('field_related_to_the_book') and not node.get('field_related_to_the_book').isEmpty() and node.field_related_to_the_book.0.entity is not null) ? node.field_related_to_the_book.0.entity.label() : '' %}

{% if owner_name == 'margot' or 'analysis' in title_lower or 'key themes' in title_lower or 'between the margins' in title_lower %}
  {% set header_variant = 'article-literary-header--margot' %}
  {% set header_kicker = '✦ Between the Margins · Margot' %}
  {% set badge_label = 'Between the Margins' %}
  {% set badge_class = 'article-badge--margot' %}
{% else %}
  {% set header_variant = 'article-literary-header--psychology' %}
  {% set header_kicker = '❖ Psychology & Trauma Recovery' %}
  {% set badge_label = 'Psychology & Healing' %}
  {% set badge_class = 'article-badge--psychology' %}
{% endif %}

<article{{ attributes.addClass(node_classes) }}>
  {% if has_image %}
    <div class="card-img-top-wrapper p-0 d-flex align-items-center justify-content-center" style="height: 170px; overflow: hidden;">
      {{ content.field_image }}
    </div>
  {% else %}
    <a href="{{ url }}" rel="bookmark" class="card-img-top-wrapper article-literary-header {{ header_variant }}" aria-label="{{ title_text }}">
      <div class="article-literary-header__frame">
        <span class="article-literary-header__quote-mark" aria-hidden="true">“</span>
        <span class="article-literary-header__kicker">{{ header_kicker }}</span>
        <span class="article-literary-header__title">{{ title_text }}</span>
        {% if related_book %}
          <span class="article-literary-header__book">On: {{ related_book }}</span>
        {% endif %}
      </div>
    </a>
  {% endif %}
  
  <div class="card-body d-flex flex-column p-3">
    <div class="article-card-badges d-flex flex-wrap gap-1 mb-2">
      <span class="badge text-uppercase fw-bold {{ badge_class }}">
        {{ badge_label }}
      </span>
      {% if related_book %}
        <span class="badge article-badge--book text-truncate" style="max-width: 100%;" title="{{ related_book }}">
          {{ related_book }}
        </span>
      {% endif %}
    </div>

    {{ title_prefix }}
    <h3{{ title_attributes.addClass('card-title', 'h5', 'mb-2', 'fw-bold') }}>
      <a href="{{ url }}" rel="bookmark" class="text-dark text-decoration-none hover-gold">{{ label }}</a>
    </h3>
    {{ title_suffix }}
    
    <div class="card-meta text-muted mb-2" style="font-size: 0.8rem;">
      <span>{{ date }}</span>
      {% if owner_name == 'margot' %}
        <span> · By Margot (AI Literary Companion)</span>
      {% else %}
        <span> · By Bruce Whealton</span>
      {% endif %}
    </div>

    <div class="card-text text-muted flex-grow-1 mb-3" style="font-size: 0.92rem; line-height: 1.55;">
      {{ content.body }}
    </div>
    
    <div class="mt-auto pt-2">
      <a href="{{ url }}" class="btn btn-outline-warning btn-sm w-100 fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Read Full Article</a>
    </div>
  </div>
</article>
