<?php

/**
 * @file
 * Theme and preprocess functions for nodes.
 */

use Drupal\node\NodeInterface;

/**
 * Prepares reading context, sequence links, and contents for Book pages.
 */
function drupal_cms_radix_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if ($node instanceof NodeInterface && $node->bundle() === 'book_cover_and_description' && ($variables['view_mode'] ?? '') === 'full' && !$node->isNew()) {
    $manager = \Drupal::service('book.manager');
    $link = $manager->loadBookLink((int) $node->id());
    if ($link && (int) $link['bid'] === (int) $node->id()) {
      $cache = new \Drupal\Core\Cache\CacheableMetadata();
      $cache->addCacheTags(['config:system.book.' . $node->id(), 'node_list']);
      foreach ($manager->bookTreeGetFlat($link) as $item) {
        $part = \Drupal::entityTypeManager()->getStorage('node')->load($item['nid']);
        if (!$part || (int) $part->id() === (int) $node->id()) {
          continue;
        }
        $access = $part->access('view', NULL, TRUE);
        $cache->addCacheableDependency($part)->addCacheableDependency($access);
        if ($access->isAllowed()) {
          $variables['content']['start_reading'] = [
            '#type' => 'container',
            '#attributes' => ['class' => ['book-start-reading', 'my-3']],
            '#weight' => ($variables['content']['body']['#weight'] ?? 2) + 0.5,
            'label' => ['#type' => 'html_tag', '#tag' => 'p', '#value' => t('New to this book?')],
            'start' => [
              '#type' => 'link',
              '#title' => t('Start Reading'),
              '#url' => $part->toUrl(),
              '#attributes' => ['class' => ['btn', 'btn-primary']],
            ],
          ];
          $variables['content']['returning_reader'] = [
            '#type' => 'link',
            '#title' => t('Returning? Jump to the Table of Contents'),
            '#url' => \Drupal\Core\Url::fromRoute('<current>', [], ['fragment' => 'book-table-of-contents']),
            '#weight' => -10,
            '#prefix' => '<p class="book-returning-reader">',
            '#suffix' => '</p>',
          ];
          break;
        }
      }
      $cache->applyTo($variables['content']);
    }
  }
  if ($node instanceof NodeInterface && $node->bundle() === 'person' && ($variables['view_mode'] ?? '') === 'full' && !$node->isNew()) {
    $cache = new \Drupal\Core\Cache\CacheableMetadata();
    $cache->addCacheTags(['node_list:book_cover_and_description']);
    $query = \Drupal::entityQuery('node')
      ->accessCheck(TRUE)
      ->condition('status', 1)
      ->condition('type', 'book_cover_and_description')
      ->condition('field_book_authors.target_id', (int) $node->id());
    if (\Drupal\field\Entity\FieldStorageConfig::loadByName('node', 'field_display_order')) {
      $query->sort('field_display_order', 'ASC');
    }
    $book_ids = $query
      ->sort('created', 'DESC')
      ->execute();
    if ($book_ids) {
      $items = [];
      foreach (\Drupal::entityTypeManager()->getStorage('node')->loadMultiple($book_ids) as $authored_book) {
        $access = $authored_book->access('view', NULL, TRUE);
        $cache->addCacheableDependency($authored_book)->addCacheableDependency($access);
        if ($access->isAllowed()) {
          $items[] = [
            '#type' => 'link',
            '#title' => $authored_book->label(),
            '#url' => $authored_book->toUrl(),
          ];
        }
      }
      if ($items) {
        $display_name = $node->uuid() === 'd3db7e7d-45ee-4f9f-a5eb-959582aae5d6'
          ? 'Bruce Whealton'
          : (string) ($node->get('field_person_name')->value ?: $node->label());
        $variables['content']['person_authored_books'] = [
          '#type' => 'container',
          '#attributes' => ['class' => ['person-authored-books', 'mt-4', 'pt-3']],
          '#weight' => 100,
          'heading' => [
            '#type' => 'html_tag',
            '#tag' => 'h2',
            '#value' => t('Books by @name', ['@name' => $display_name]),
            '#attributes' => ['class' => ['person-authored-books__title', 'h4', 'mb-3']],
          ],
          'list' => [
            '#theme' => 'item_list',
            '#items' => $items,
            '#attributes' => ['class' => ['person-authored-books__list', 'mb-3']],
          ],
          'all_books' => [
            '#type' => 'link',
            '#title' => t('Browse All Books with Covers & Descriptions'),
            '#url' => \Drupal\Core\Url::fromUserInput('/books-by-bruce-whealton'),
            '#attributes' => ['class' => ['btn', 'btn-outline-primary', 'btn-sm']],
          ],
        ];
        $cache->applyTo($variables['content']);
      }
    }
  }
  if (!$node instanceof NodeInterface || !in_array($node->bundle(), ['book', 'book_page', 'book_part'], TRUE)) {
    return;
  }

  $book_row = \Drupal::database()
    ->select('book', 'b')
    ->fields('b')
    ->condition('nid', (int) $node->id())
    ->execute()
    ->fetchAssoc();

  if (!$book_row || empty($book_row['bid'])) {
    return;
  }

  $rows = \Drupal::database()
    ->select('book', 'b')
    ->fields('b', ['nid', 'bid', 'pid', 'depth', 'weight', 'p1', 'p2', 'p3', 'p4', 'p5', 'p6', 'p7', 'p8', 'p9'])
    ->condition('bid', (int) $book_row['bid'])
    ->orderBy('p1')
    ->orderBy('p2')
    ->orderBy('p3')
    ->orderBy('p4')
    ->orderBy('p5')
    ->orderBy('p6')
    ->orderBy('p7')
    ->orderBy('p8')
    ->orderBy('p9')
    ->orderBy('weight')
    ->execute()
    ->fetchAllAssoc('nid');

  if (!$rows) {
    return;
  }

  $nodes = \Drupal::entityTypeManager()
    ->getStorage('node')
    ->loadMultiple(array_keys($rows));

  $items = [];
  $item_by_nid = [];
  $current_index = NULL;
  foreach ($rows as $nid => $row) {
    if (empty($nodes[$nid]) || !$nodes[$nid]->access('view')) {
      continue;
    }

    $item = [
      'nid' => (int) $nid,
      'title' => $nodes[$nid]->label(),
      'url' => $nodes[$nid]->toUrl()->toString(),
      'depth' => max(1, min(9, (int) $row->depth)),
      'is_current' => (int) $nid === (int) $node->id(),
    ];

    if ($item['is_current']) {
      $current_index = count($items);
    }

    $items[] = $item;
    $item_by_nid[(int) $nid] = $item;
  }

  $trail = [];
  $current_row = $rows[$node->id()] ?? NULL;
  if ($current_row) {
    for ($level = 1; $level <= (int) $current_row->depth; $level++) {
      $ancestor_nid = (int) ($current_row->{'p' . $level} ?? 0);
      if ($ancestor_nid && isset($item_by_nid[$ancestor_nid])) {
        $trail[] = $item_by_nid[$ancestor_nid];
      }
    }
  }

  $book = $trail[0] ?? reset($items);

  $authors = [];
  $root_book = $nodes[(int) $book_row['bid']] ?? \Drupal::entityTypeManager()->getStorage('node')->load((int) $book_row['bid']);
  if ($root_book instanceof NodeInterface && $root_book->hasField('field_book_authors')) {
    foreach ($root_book->get('field_book_authors')->referencedEntities() as $person) {
      if ($person instanceof NodeInterface && $person->access('view')) {
        $name = $person->uuid() === 'd3db7e7d-45ee-4f9f-a5eb-959582aae5d6'
          ? 'Bruce Whealton'
          : (string) ($person->get('field_person_name')->value ?: $person->label());
        $authors[] = [
          'name' => $name,
          'url' => $person->toUrl()->toString(),
        ];
      }
    }
  }
  $variables['book_authors'] = $authors;
  $variables['books_list_url'] = \Drupal\Core\Url::fromUserInput('/books-by-bruce-whealton')->toString();

  $variables['book_toc_items'] = $items;
  $variables['book_reading_context'] = [
    'book' => $book ?: NULL,
    'trail' => $trail,
    'section_trail' => array_slice($trail, 1, -1),
    'depth_label' => drupal_cms_radix_book_depth_label((int) ($current_row->depth ?? 1)),
  ];

  if ($current_index !== NULL) {
    $variables['book_previous_item'] = $items[$current_index - 1] ?? NULL;
    $variables['book_next_item'] = $items[$current_index + 1] ?? NULL;
  }
}

/**
 * Lets the Book Part template place its title after Part and Section headings.
 */
function drupal_cms_radix_preprocess_page_title(array &$variables): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface && $node->bundle() === 'book_part') {
    $variables['title'] = '';
  }
}

/**
 * Gives readable labels to the first few levels of a Book outline.
 */
function drupal_cms_radix_book_depth_label(int $depth): string {
  return match ($depth) {
    1 => 'Book',
    2 => 'Chapter',
    3 => 'Section',
    4 => 'Part',
    default => 'Page',
  };
}
